{
  "name": "sable-sky-hotel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "qa:browser": "node tests/browser.mjs",
    "start:api": "node server/index.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "mongoose": "8.12.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/express": "4.17.21",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.22.0",
    "globals": "16.0.0",
    "playwright": "1.51.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.2.2"
  },
  "overrides": { "rollup": "4.67.5" }
}
